<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image Header Placeholder (using gradient background since no image loads) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_gradient">
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                <TextView android:id="@+id/tvCardType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_primary_button" android:backgroundTint="#99000000" android:text="Bootcamp" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/tvCardPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_primary_button" android:backgroundTint="#99000000" android:text="Free" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" />
                <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvCardMatch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_primary_button" android:backgroundTint="#5B54E3" android:text="87% Match" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" />
            </LinearLayout>

            <TextView android:id="@+id/tvCardLocationTop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍 Innovation Lab" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" android:layout_alignParentBottom="true" android:layout_alignParentStart="true" android:layout_margin="16dp" />
        </RelativeLayout>

        <!-- Card Body -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            
            <TextView android:id="@+id/tvEventTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cybersecurity Bootcamp" android:textColor="#0F172A" android:textStyle="bold" android:textSize="18sp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvEventOrg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SecureStack Academy" android:textColor="#3B35A8" android:textSize="14sp" android:layout_marginBottom="16dp" />
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📅 25 Aug 2026" android:textColor="#475569" android:textSize="13sp" />
                <TextView android:id="@+id/tvTime" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🕒 10:00-13:00" android:textColor="#475569" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <TextView android:id="@+id/tvRegistered" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="👥 Open" android:textColor="#475569" android:textSize="13sp" />
                <TextView android:id="@+id/tvDistance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📍 Various" android:textColor="#475569" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
                <TextView android:id="@+id/tvTag1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_primary_button" android:backgroundTint="#F1F5F9" android:text="Cybersecurity" android:textColor="#0F172A" android:textSize="12sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/tvTag2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_primary_button" android:backgroundTint="#F1F5F9" android:text="Event" android:textColor="#0F172A" android:textSize="12sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnView" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="View Event" android:textAllCaps="false" android:backgroundTint="#FFFFFF" android:textColor="#0F172A" app:strokeColor="#E2E8F0" app:strokeWidth="1dp" android:layout_marginEnd="6dp" />
                <Button android:id="@+id/btnRegister" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Register" android:textAllCaps="false" android:backgroundTint="#5B54E3" android:textColor="#FFFFFF" android:layout_marginStart="6dp" />
            </LinearLayout>
            <Button android:id="@+id/btnVolunteer" android:layout_width="match_parent" android:layout_height="48dp" android:text="Volunteer for Event" android:textAllCaps="false" android:backgroundTint="#FFFFFF" android:textColor="#5B54E3" app:strokeColor="#5B54E3" app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
