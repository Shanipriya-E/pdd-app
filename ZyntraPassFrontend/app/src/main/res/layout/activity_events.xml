<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainEvents"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@drawable/bg_outlined_button"
            android:padding="10dp"
            app:tint="#0D162A" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        

        <TextView
            android:id="@+id/tvUserAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="#E0E7FF"
            android:text="U"
            android:textColor="#5B54E3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Events"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create, configure and monitor every event your organisation runs."
                android:textColor="#475569"
                android:textSize="15sp"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:id="@+id/btnCreateEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_primary_button"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:gravity="center"
                android:layout_marginBottom="32dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="18sp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create event" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
            </LinearLayout>

            <!-- Search -->
            <EditText android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_outlined_button"
                android:hint="Search your events..."
                android:paddingHorizontal="16dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:textColor="#0D162A"
                android:textColorHint="#64748B"
                android:layout_marginBottom="24dp" />

            <!-- Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">
                
                <LinearLayout
                    android:id="@+id/llTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <!-- All Tab -->
                    <LinearLayout android:id="@+id/tabAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp" android:layout_marginEnd="24dp" android:background="@drawable/bg_tab_indicator">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All" android:textColor="#3B35A8" android:textStyle="bold" android:textSize="15sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/badgeAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#3B35A8" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_role_button" android:backgroundTint="#EEF2FF" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>
                    
                    <!-- Upcoming Tab -->
                    <LinearLayout android:id="@+id/tabUpcoming" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp" android:layout_marginEnd="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upcoming" android:textColor="#475569" android:textStyle="bold" android:textSize="15sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/badgeUpcoming" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#334155" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_role_button" android:backgroundTint="#F1F5F9" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>

                    <!-- Ongoing Tab -->
                    <LinearLayout android:id="@+id/tabOngoing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp" android:layout_marginEnd="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ongoing" android:textColor="#475569" android:textStyle="bold" android:textSize="15sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/badgeOngoing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#334155" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_role_button" android:backgroundTint="#F1F5F9" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>

                    <!-- Completed Tab -->
                    <LinearLayout android:id="@+id/tabCompleted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp" android:layout_marginEnd="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Completed" android:textColor="#475569" android:textStyle="bold" android:textSize="15sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/badgeCompleted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#334155" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_role_button" android:backgroundTint="#F1F5F9" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>

                    <!-- Cancelled Tab -->
                    <LinearLayout android:id="@+id/tabCancelled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp" android:layout_marginEnd="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancelled" android:textColor="#475569" android:textStyle="bold" android:textSize="15sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/badgeCancelled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#334155" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_role_button" android:backgroundTint="#F1F5F9" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Event Feed -->
            <LinearLayout
                android:id="@+id/llEventsFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading events..."
                    android:gravity="center"
                    android:textColor="#64748B"
                    android:layout_marginTop="40dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingVertical="12dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Dashboard -->
        <LinearLayout android:id="@+id/navDashboard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚏" android:textSize="20sp" android:textColor="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textSize="12sp" android:textColor="#64748B" android:textStyle="bold" />
        </LinearLayout>

        <!-- Events -->
        <LinearLayout android:id="@+id/navEvents" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="20sp" android:textColor="#3B35A8" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Events" android:textSize="12sp" android:textColor="#3B35A8" android:textStyle="bold" />
        </LinearLayout>

        <!-- Participants -->
        <LinearLayout android:id="@+id/navParticipants" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="20sp" android:textColor="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Participants" android:textSize="12sp" android:textColor="#64748B" android:textStyle="bold" />
        </LinearLayout>

        <!-- Live -->`n        <LinearLayout android:id="@+id/navLive" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📡" android:textSize="20sp" android:textColor="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live" android:textSize="12sp" android:textColor="#64748B" android:textStyle="bold" />
        </LinearLayout>

        <!-- More -->
        <LinearLayout android:visibility="gone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More"/></LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
