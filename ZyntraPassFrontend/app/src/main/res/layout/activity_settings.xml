<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@drawable/bg_outlined_button"
            android:padding="10dp"
            app:tint="#0D162A" />

        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        

        <TextView
            android:id="@+id/tvUserAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="#E0E7FF"
            android:text="U"
            android:textColor="#5B54E3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage your organizer account, security and privacy."
                android:textColor="#475569"
                android:textSize="15sp"
                android:layout_marginBottom="24dp" />

            <!-- Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <LinearLayout android:id="@+id/tabAccount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="24dp">
                        <TextView android:id="@+id/tvTabAccount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account" android:textColor="#3B35A8" android:textStyle="bold" android:textSize="15sp" android:paddingBottom="12dp" />
                        <View android:id="@+id/indAccount" android:layout_width="match_parent" android:layout_height="2dp" android:background="#3B35A8" />
                    </LinearLayout>
                    
                    <LinearLayout android:id="@+id/tabSecurity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="24dp">
                        <TextView android:id="@+id/tvTabSecurity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Security" android:textColor="#475569" android:textStyle="bold" android:textSize="15sp" android:paddingBottom="12dp" />
                        <View android:id="@+id/indSecurity" android:layout_width="match_parent" android:layout_height="2dp" android:background="@android:color/transparent" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tabNotifications" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="24dp">
                        <TextView android:id="@+id/tvTabNotifications" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notifications" android:textColor="#475569" android:textStyle="bold" android:textSize="15sp" android:paddingBottom="12dp" />
                        <View android:id="@+id/indNotifications" android:layout_width="match_parent" android:layout_height="2dp" android:background="@android:color/transparent" />
                    </LinearLayout>
                    
                    <LinearLayout android:id="@+id/tabPrivacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="24dp">
                        <TextView android:id="@+id/tvTabPrivacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Privacy" android:textColor="#475569" android:textStyle="bold" android:textSize="15sp" android:paddingBottom="12dp" />
                        <View android:id="@+id/indPrivacy" android:layout_width="match_parent" android:layout_height="2dp" android:background="@android:color/transparent" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>
            
            <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#E2E8F0" android:layout_marginTop="-18dp" android:layout_marginBottom="24dp"/>

            <!-- Account Content -->
            <LinearLayout
                android:id="@+id/contentAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_white_button"
                    android:padding="20dp"
                    android:elevation="1dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profile details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="4dp" />
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="This is your global ZyntraPass identity across all organisations"
                        android:textColor="#475569"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full name" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etFullName" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_outlined_button" android:backgroundTint="#F8FAFC" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" android:enabled="false" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Institution / Organisation" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etInstitution" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Area / City" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etCity" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Native place" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etNative" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save changes"
                        android:textAllCaps="false"
                        android:backgroundTint="#5B54E3"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_white_button"
                    android:padding="20dp"
                    android:elevation="1dp"
                    android:layout_marginBottom="16dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Log out of ZyntraPass"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="4dp" />
                        
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="You'll need to sign in again to access your events."
                        android:textColor="#475569"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp" />
                        
                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Logout"
                        android:textAllCaps="false"
                        android:backgroundTint="#DC2626"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Security Content -->
            <LinearLayout
                android:id="@+id/contentSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_white_button"
                    android:padding="20dp"
                    android:elevation="1dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change password"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="20dp" />
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current password" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etCurrentPass" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textPassword" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New password" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etNewPass" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textPassword" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Confirm new password" android:textColor="#0F172A" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/etConfirmPass" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textPassword" android:background="@drawable/bg_outlined_button" android:paddingHorizontal="16dp" android:textColor="#0F172A" android:textSize="15sp" android:layout_marginBottom="20dp" />

                    <Button
                        android:id="@+id/btnUpdatePassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update password"
                        android:textAllCaps="false"
                        android:backgroundTint="#5B54E3"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            
            <!-- Other Tabs Content (Empty state) -->
            <LinearLayout android:id="@+id/contentOther" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_button" android:padding="20dp" android:elevation="1dp">
                    <TextView android:id="@+id/tvOtherTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Title" android:textSize="18sp" android:textStyle="bold" android:textColor="#0F172A" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings will be available in the next update." android:textColor="#475569" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingVertical="12dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/navDashboard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚏" android:textSize="20sp" android:textColor="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textSize="12sp" android:textColor="#64748B" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navEvents" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="20sp" android:textColor="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Events" android:textSize="12sp" android:textColor="#64748B" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navParticipants" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="20sp" android:textColor="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Participants" android:textSize="12sp" android:textColor="#64748B" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navLive" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📡" android:textSize="20sp" android:textColor="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live" android:textSize="12sp" android:textColor="#64748B" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:visibility="gone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More"/></LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
