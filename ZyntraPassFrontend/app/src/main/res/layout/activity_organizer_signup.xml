<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainSignup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Create your organizer account"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="One account works across every organisation and every event, forever."
            android:textColor="#A8B2D1"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        

        <!-- Form Fields -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Full Name"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Email"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etFullName" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Phone Number"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:inputType="phone"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etEmail" />

        <EditText
            android:id="@+id/etInstitution"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Institution / College / Company"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etPhone" />

        <EditText
            android:id="@+id/etAreaCity"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Area / City"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etInstitution" />

        <EditText
            android:id="@+id/etNativePlace"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Native Place"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etAreaCity" />

        <!-- Secret Key -->
        <TextView
            android:id="@+id/tvSecretHint"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="wrap_content"
            android:text="Important: Set a Secret Key below. You will need this key every time you log in to access the Organizer Dashboard. Keep it safe!"
            android:textColor="#FFFFFF"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/etNativePlace" />

        <EditText
            android:id="@+id/etSecretKey"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Secret Key (2FA)"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvSecretHint" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Password"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etSecretKey" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:hint="Confirm Password"
            android:textColorHint="#A8B2D1"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:background="@drawable/bg_outlined_button"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etPassword" />

        <Button
            android:id="@+id/btnSubmitSignup"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="60dp"
            android:text="Create account"
            android:background="@drawable/bg_primary_button"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

        <TextView
            android:id="@+id/tvSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Sign in"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/btnSubmitSignup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>




